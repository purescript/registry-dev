#!/usr/bin/env bash
set -euo pipefail

# Keep timings in setup.log without tracing commands or environment secrets.
TIMEFORMAT='Step finished in %3R seconds'
trap 'status=$?; echo "Orb setup exited with status $status after ${SECONDS}s"' EXIT

echo "Installing orb prerequisites..."
if ! command -v direnv >/dev/null 2>&1; then
  time sudo apt-get update
  time sudo DEBIAN_FRONTEND=noninteractive apt-get install -y direnv
fi

# Make the repository's existing .envrc activate in interactive orb terminals.
direnv_hook='eval "$(direnv hook bash)"'
if ! grep -Fqx "$direnv_hook" "$HOME/.bashrc"; then
  printf '\n%s\n' "$direnv_hook" >> "$HOME/.bashrc"
fi

if ! command -v nix >/dev/null 2>&1 \
  && [ ! -x /nix/var/nix/profiles/default/bin/nix ]; then
  time curl --proto '=https' --tlsv1.2 -fsSL https://install.determinate.systems/nix \
    | sh -s -- install --no-confirm
fi

# The installer updates future login shells, but this setup process also needs Nix.
if [ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
  # shellcheck disable=SC1091
  source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

# Amp commands use non-login shells, so expose Nix on their existing PATH too.
# Preserve the active installation, including single-user Nix installations.
nix_bin="$(command -v nix)"
nix_bin="$(readlink -f "$nix_bin")"
mkdir -p "$HOME/.local/bin"
ln -sfn "$nix_bin" "$HOME/.local/bin/nix"

echo "Preparing the pinned Nix development environment..."
direnv allow .
# Load the same flake as .envrc directly: direnv's use_flake can hide Nix
# failures behind eval and continue with tools from outside the dev shell.
# Reuse direnv's profile so interactive terminals retain the same store roots.
mkdir -p .direnv
time nix_env="$(nix print-dev-env --profile .direnv/flake-profile)"
eval "$nix_env"

echo "Installing locked npm dependencies..."
time npm ci --omit=optional --no-audit --no-fund

echo "Building the PureScript workspace..."
time spago build

echo "Orb setup complete."
